# ============================================================================
# Velonix — Environment Variables Reference
# ============================================================================
#
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# Each section maps to a config factory in apps/api/src/config/
# ============================================================================


# ── Application ──────────────────────────────────────────────────────────────

NODE_ENV=development

# Web app public URL (Next.js)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API URL (used by Next.js to call the backend)
NEXT_PUBLIC_API_URL=http://localhost:3001

# API internal URL (server-side Next.js → NestJS; can be internal in production)
API_URL=http://localhost:3001

# API port
PORT=3001

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000


# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# Use DATABASE_URL in production (overrides individual vars)
# DATABASE_URL=postgresql://user:password@host:5432/velonix?sslmode=require

# Development individual vars
DB_HOST=localhost
DB_PORT=5432
DB_USER=velonix
DB_PASS=velonix_dev_password
DB_NAME=velonix_dev

# Set to "true" ONLY in local dev to auto-sync schema (never in production)
DB_SYNC=false


# ── Authentication ────────────────────────────────────────────────────────────

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_64_CHARS_MINIMUM
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_STRING_64_CHARS

JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# NextAuth (web app)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET_32_CHARS_MIN

# OAuth providers (optional — for social login)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Password hashing rounds (10-14 recommended; higher = slower but more secure)
BCRYPT_ROUNDS=12


# ── Stripe ────────────────────────────────────────────────────────────────────

# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY
# Exposed to the browser for Stripe.js (Elements) on the payment page
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_KEY

# Webhook secret — from `stripe listen --forward-to localhost:3001/api/v1/payments/webhook`
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SECRET

# Stripe Product IDs — create in Stripe dashboard
STRIPE_PRODUCT_CREATOR=prod_REPLACE
STRIPE_PRODUCT_PRO=prod_REPLACE
STRIPE_PRODUCT_STUDIO=prod_REPLACE

# Stripe Price IDs — monthly subscriptions
STRIPE_PRICE_CREATOR_MONTHLY=price_REPLACE
STRIPE_PRICE_CREATOR_YEARLY=price_REPLACE
STRIPE_PRICE_PRO_MONTHLY=price_REPLACE
STRIPE_PRICE_PRO_YEARLY=price_REPLACE
STRIPE_PRICE_STUDIO_MONTHLY=price_REPLACE
STRIPE_PRICE_STUDIO_YEARLY=price_REPLACE


# ── Storage (AWS S3 / Cloudflare R2 / MinIO) ─────────────────────────────────

STORAGE_PROVIDER=s3

# S3 / R2 / MinIO bucket name
S3_BUCKET=velonix-assets-dev

# AWS region (use 'auto' for Cloudflare R2)
AWS_REGION=us-east-1

# AWS credentials
AWS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_SECRET_KEY

# Custom endpoint (Cloudflare R2: https://ACCOUNT_ID.r2.cloudflarestorage.com)
# MinIO local: http://localhost:9000
# Leave blank for standard AWS S3
# S3_ENDPOINT=

# CDN URL for serving assets (leave blank to use S3 directly)
# CDN_URL=https://assets.velonix.gg

# Max upload size in bytes (default: 50 MB)
MAX_FILE_SIZE_BYTES=52428800


# ── Email (Resend / SendGrid / SES) ──────────────────────────────────────────

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_REPLACE_WITH_API_KEY
EMAIL_FROM=noreply@velonix.gg
EMAIL_FROM_NAME=Velonix


# ── Redis (for session store / job queues) ────────────────────────────────────

# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=


# ── Monitoring & Observability ────────────────────────────────────────────────

# Sentry DSN (optional — error tracking)
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=

# Posthog (optional — product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ── Development helpers ───────────────────────────────────────────────────────

# Log level: error | warn | info | debug | verbose
LOG_LEVEL=debug


# ── Admin seed account ────────────────────────────────────────────────────────
# Seeded on first run. Change these before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!Admin1
ADMIN_USERNAME=admin

# Swagger
ENABLE_SWAGGER=true