{
  "name": "velonix",
  "version": "0.1.0",
  "private": true,
  "description": "Velonix — Premium Digital Board Game Creation & Publishing Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:api": "pnpm --filter @velonix/api... build",
    "dev": "turbo run dev --parallel",
    "dev:web": "turbo run dev --filter=@velonix/web",
    "dev:api": "turbo run dev --filter=@velonix/api",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "prepare": "husky install",
    "db:migrate": "turbo run db:migrate --filter=@velonix/api",
    "db:seed": "turbo run db:seed --filter=@velonix/api",
    "db:studio": "turbo run db:studio --filter=@velonix/api"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "prettier": "^3.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "@types/node": "^22.10.7",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
